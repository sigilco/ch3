{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "overrides": [
    {
      "files": ["**/index.ts"],
      "rules": {
        "typescript/no-this-alias": "off"
      }
    },
    {
      "files": ["packages/router/src/index.ts"],
      "rules": {
        "eslint/no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/fixtures/**",
    "**/dist/**",
    "bench/ceilings/**",
    "**/mongoose.c",
    "packages/router/test/fixtures/**",
    "packages/unplugin/test/fixtures/**"
  ]
}
