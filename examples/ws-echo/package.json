{
  "name": "chttp-example-ws-echo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build": "node scripts/vendor.mjs && cc -c ffi_native.c -o .vendor/ffi_native.o && scriptc build src/main.ts --ffi .vendor/ffi.json -o app",
    "start": "./app",
    "start:node": "node scripts/vendor.mjs && node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@chttp/router": "workspace:*",
    "@chttp/ws": "workspace:*"
  },
  "devDependencies": {
    "scriptc": ">=0.3.2"
  }
}
