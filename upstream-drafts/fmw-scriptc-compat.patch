@@ -44,24 +50,33 @@ const REMOVE_DUPLICATE_SLASHES_REGEXP = /\/\/+/g
 // URL.parse returns null instead of throwing on malformed input, which skips
 // the error and stack trace allocation on an attacker controlled path. It is
 // only available since Node.js 20.18.0, so fall back to URL.canParse.
-const parseUrl = typeof URL.parse === 'function'
-  ? URL.parse
-  : (url) => URL.canParse(url) ? new URL(url) : null
+// URL.parse returns null instead of throwing, but it is not yet available on
+// every runtime this module supports — try/catch around `new URL` gives the
+// same null-on-bad-input contract everywhere.
+const parseUrl = (url) => {
+  try {
+    return new URL(url)
+  } catch {
+    return null
+  }
+}
 
