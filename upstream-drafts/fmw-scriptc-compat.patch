 */
 
 const assert = require('node:assert')
-const querystring = require('fast-querystring')
-const isRegexSafe = require('safe-regex2')
+const querystring = require('node:querystring')
+// safe-regex2 is an optional dependency: exotic runtimes/compilers that
+// cannot load it skip the regex-safety checks (equivalent to
+// allowUnsafeRegex). Plain-route routing never needs it.
+let isRegexSafe = null
+try {
+  isRegexSafe = require('safe-regex2')
+} catch {}
